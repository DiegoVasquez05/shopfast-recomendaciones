# Copiar a .env y CAMBIAR todos los secretos antes de exponer la EC2.
#   openssl rand -hex 32   -> JWT_SECRET / PII_SALT
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" -> MESSAGE_ENCRYPTION_KEY
ENVIRONMENT=piloto
JWT_SECRET=
PII_SALT=
MESSAGE_ENCRYPTION_KEY=
OAUTH_CLIENTS=mobile-app:cambiar1,dashboard:cambiar2,agent-console:cambiar3,loadtest:cambiar4
DASHBOARD_CLIENT_SECRET=cambiar2
POSTGRES_USER=telecombot
POSTGRES_PASSWORD=cambiar
RABBITMQ_USER=telecombot
RABBITMQ_PASSWORD=cambiar
SIEBEL_USER=telecombot
SIEBEL_PASSWORD=cambiar
# --- AWS (AWS Academy) ---
AWS_REGION=us-east-1
SAGEMAKER_ENDPOINT=            # ej. telecombot-nlu (vacío = modelo local)
S3_BUCKET=                     # bucket para datos y modelos
SIEBEL_SECRET_ARN=             # opcional: credenciales Siebel en AWS Secrets Manager
SENTIMENT_PROVIDER=lexicon     # comprehend = Amazon Comprehend
LLM_PROVIDER=extractive        # bedrock = Amazon Bedrock (requiere WITH_LLM=true al construir)
WITH_LLM=false
# --- Cola: rabbitmq (por defecto) o sqs ---
QUEUE_BACKEND=rabbitmq
SQS_QUEUE_URL=
# --- WhatsApp Business (opcional) ---
WHATSAPP_VERIFY_TOKEN=cambiar
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# --- Piloto ---
PILOT_PERCENTAGE=10
PILOT_ALLOWLIST=demo,wa
